# ===== TokenScope - Biến môi trường =====

# Kết nối SQL Server (database "TokenScope").
# Prisma không hỗ trợ Windows Authentication, dùng SQL Authentication.
# Lưu ý định dạng: tham số nối bằng dấu ";" và đặt user/password trong chuỗi.
# Mật khẩu nên chỉ dùng chữ/số để không phải escape ký tự đặc biệt.
DATABASE_URL="sqlserver://localhost:1433;database=TokenScope;user=<USER>;password=<PASSWORD>;encrypt=false;trustServerCertificate=true;connectionLimit=5"

# ===== Xác thực =====
JWT_ACCESS_SECRET="tokenscope-access-secret-change-me"
JWT_REFRESH_SECRET="tokenscope-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== CORS =====
# Danh sách origin được phép (phân tách bằng dấu phẩy).
# Ở môi trường development, mọi origin localhost/127.0.0.1 ở bất kỳ cổng nào
# cũng được phép — Flutter Web dev server thường tự chọn cổng ngẫu nhiên.
# Ở production, danh sách này được áp dụng nghiêm ngặt.
CORS_ORIGIN="http://localhost:3000,http://localhost:8099"

# ===== Admin Web =====
# Danh sách email được coi là admin (fallback khi role trong DB chưa đặt).
# Phân quyền chuẩn vẫn là `User.role = 'admin'` trong database.
ADMIN_EMAILS="demo@tokenscope.io"
# Cho phép cơ chế fallback bằng email (đặt false nếu chỉ dùng role trong DB).
ADMIN_ALLOW_BY_EMAIL="true"

# ===== Crash Testing =====
# Chỉ dùng cho môi trường demo/testing — TUYỆT ĐỐI không bật trên production.
# Khi bật, Admin Web có thể gửi lệnh crash có chủ đích tới Flutter App đang
# chạy để kiểm thử Firebase Crashlytics.
CRASH_TESTING_ENABLED="false"
# Các môi trường được phép kích hoạt crash test.
CRASH_TESTING_ENVIRONMENTS="development,staging,test,demo"

# ===== Firebase Analytics (GA4 Data API) =====
# Property ID của GA4 (dạng properties/123456789 hoặc chỉ 123456789).
# Để trống nếu chưa cấu hình — Admin Web sẽ hiển thị thông báo thay vì lỗi.
FIREBASE_ANALYTICS_PROPERTY_ID=""
# Service account JSON: nội dung JSON thô hoặc đường dẫn tới file JSON.
# Cần quyền "Viewer" trên GA4 property.
FIREBASE_ANALYTICS_CREDENTIALS=""

# Firebase project dùng cho Crashlytics (để Admin Web mở đúng trang Console).
FIREBASE_PROJECT_ID="tokenscope-5116d"

# ===== OpenAI =====# Secret API Key — dùng để đọc danh sách model (GET /v1/models) và gọi model.
# Tạo tại https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Admin API Key — dùng để đọc Usage & Costs ở cấp TỔ CHỨC:
#   GET /v1/organization/usage/completions
#   GET /v1/organization/costs
# Tạo tại https://platform.openai.com/settings/organization/admin-keys
# Bắt buộc có quyền đọc Usage & Costs trong Organization settings.
# KHÔNG dùng khoá này để gọi model inference.
#
# LƯU Ý (hướng A): người dùng thường nhập Admin API Key của RIÊNG họ ngay
# trong màn hình "Kết nối nhà cung cấp" — khoá đó được mã hoá (AES-256-GCM)
# và lưu trong bảng `api_providers.adminKeyCipher` theo từng kết nối.
# Biến dưới đây chỉ là **fallback** cho các kết nối mà người dùng chưa cung cấp
# khoá (ví dụ trong môi trường demo/demo server).
OPENAI_ADMIN_API_KEY=""

# Cho phép đọc dữ liệu Usage/Costs cấp tổ chức.
# Dữ liệu này là của toàn tổ chức nên có thể thấy hoạt động của thành viên
# khác — mặc định TẮT, chỉ bật khi chủ dự án đồng ý.
#
# LƯU Ý: cờ này KHÔNG còn chặn người dùng đã cung cấp Admin API Key của riêng
# họ — khi đó dữ liệu đọc về thuộc tổ chức của chính họ nên không cần bật.
OPENAI_ORG_ACCESS_ENABLED="false"

# Danh sách userId được phép đọc dữ liệu Organization (phân tách bằng dấu phẩy).
# Để trống = mọi tài khoản đã đăng nhập đều được đọc (chỉ có tác dụng khi
# OPENAI_ORG_ACCESS_ENABLED="true").
OPENAI_ORG_ALLOWED_USER_IDS=""

# Base URL của OpenAI API (đổi khi dùng proxy riêng).
OPENAI_BASE_URL="https://api.openai.com"

# ===== Anthropic Claude =====
# Secret API Key — dùng cho các API thông thường của Claude:
#   GET /v1/models  (kiểm tra kết nối + đọc danh sách model)
# Tạo tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Admin API Key — dùng CHỈ cho các endpoint quản trị tổ chức:
#   GET /v1/organizations/usage_report/messages   (Usage Report)
#   GET /v1/organizations/cost_report             (Cost Report)
# Tạo tại https://console.anthropic.com/settings/admin-keys
# Bắt buộc có quyền đọc Usage & Costs ở cấp tổ chức.
# KHÔNG dùng khoá này để gọi model inference.
#
# LƯU Ý: Secret API Key KHÔNG thay thế được cho Admin API Key — Anthropic từ
# chối với mã 401/403. Người dùng thường nhập Admin API Key của RIÊNG họ
# trong màn hình "Kết nối nhà cung cấp" — khoá đó được mã hoá (AES-256-GCM)
# và lưu trong bảng `api_providers.adminKeyCipher` theo từng kết nối.
# Biến dưới đây chỉ là **fallback** cho các kết nối chưa cung cấp khoá.
ANTHROPIC_ADMIN_API_KEY=""

# Workspace ID (`wsp_...`) — TUỲ CHỌN.
# Dùng làm header `anthropic-workspace-id` khi Secret API Key chưa được scope
# vào Workspace nào. Để trống nếu khoá của bạn đã được scope sẵn.
# Không hardcode Workspace ID trong mã nguồn.
ANTHROPIC_WORKSPACE_ID=""

# Base URL của Anthropic API (đổi khi dùng proxy riêng).
ANTHROPIC_BASE_URL="https://api.anthropic.com"
