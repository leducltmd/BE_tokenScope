# ===== TokenScope - Biến môi trường =====

# Kết nối SQL Server (database "TokenScope").
# Prisma không hỗ trợ Windows Authentication, dùng SQL Authentication.
# Lưu ý định dạng: tham số nối bằng dấu ";" và đặt user/password trong chuỗi.
# Mật khẩu nên chỉ dùng chữ/số để không phải escape ký tự đặc biệt.
DATABASE_URL="sqlserver://localhost:1433;database=TokenScope;user=<USER>;password=<PASSWORD>;encrypt=false;trustServerCertificate=true;connectionLimit=5"

# ===== Xác thực =====
JWT_ACCESS_SECRET="tokenscope-access-secret-change-me"
JWT_REFRESH_SECRET="tokenscope-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== CORS =====
# Danh sách origin được phép (phân tách bằng dấu phẩy).
# Ở môi trường development, mọi origin localhost/127.0.0.1 ở bất kỳ cổng nào
# cũng được phép — Flutter Web dev server thường tự chọn cổng ngẫu nhiên.
# Ở production, danh sách này được áp dụng nghiêm ngặt.
CORS_ORIGIN="http://localhost:3000,http://localhost:8099"
