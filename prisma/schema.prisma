// Prisma schema — TokenScope
// Nguồn dữ liệu: SQL Server (database "TokenScope")
//
// Lưu ý: SQL Server không hỗ trợ nhiều đường cascade tới cùng một bảng.
// Vì vậy các quan hệ "cha" được đặt NoAction/SetNull và việc xóa được
// thực hiện tường minh trong tầng service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Người dùng của TokenScope.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  birthDate    DateTime?
  passwordHash String
  avatarUrl    String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  /// Vai trò trong hệ thống: `user` (mặc định) hoặc `admin`.
  ///
  /// Tài khoản admin được cấp quyền truy cập API của module `admin` và
  /// `crash-testing`. Việc kiểm tra thực tế vẫn dựa vào role trong DB **và**
  /// danh sách email trong `ADMIN_EMAILS` (fallback cho môi trường demo).
  role         String    @default("user")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  projects     Project[]
  apiProviders ApiProvider[]
  budgets      Budget[]
  alerts       Alert[]
  usageRecords UsageRecord[]

  appUsageEvents     AppUsageEvent[]
  crashTestDevices   CrashTestDevice[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Phiên đăng nhập (token làm mới).
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

/// Dự án — nhóm các API key theo mục đích sử dụng.
model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366F1")

  /// Môi trường triển khai — Production | Staging | Internal.
  environment String   @default("Production")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apiProviders ApiProvider[]
  usageRecords UsageRecord[]
  budgets      Budget[]

  @@index([userId])
  @@map("projects")
}

/// Nhà cung cấp API (OpenAI, Anthropic, Google...).
model ApiProvider {
  id           String   @id @default(uuid())
  userId       String
  projectId    String?
  name         String
  providerType String
  baseUrl      String?

  /// API key đã mã hoá (AES-256-GCM) — chỉ giải mã khi cần gọi nhà cung cấp.
  apiKeyCipher String?

  /// Bốn ký tự cuối của API key để hiển thị, không lưu bản rõ.
  apiKeyLast4  String?

  /// Admin API Key của tổ chức (OpenAI) đã mã hoá (AES-256-GCM).
  ///
  /// Khoá này dùng để đọc Usage & Costs ở cấp tổ chức. Secret API Key không
  /// có quyền này nên phải lưu riêng, theo từng kết nối của người dùng.
  /// Không bao giờ được trả về client hay ghi log.
  adminKeyCipher String?

  /// Bốn ký tự cuối của Admin API Key để hiển thị, không lưu bản rõ.
  adminKeyLast4  String?

  /// Workspace ID của Anthropic (bắt đầu bằng `wsp_`) đã mã hoá (AES-256-GCM).
  ///
  /// Chỉ dùng cho kết nối `providerType = 'anthropic'`. Khi API Key của
  /// Anthropic chưa được scope vào Workspace nào, mọi request phải kèm header
  /// `anthropic-workspace-id` — giá trị này giải mã từ trường này.
  ///
  /// Tách riêng hoàn toàn khỏi API Key của OpenAI: mỗi kết nối Claude quản lý
  /// khoá + workspace của riêng nó. Không bao giờ trả bản rõ về client.
  workspaceIdCipher String?

  /// Bốn ký tự cuối của Workspace ID để hiển thị, không lưu bản rõ.
  workspaceIdLast4  String?

  /// Trạng thái kiểm tra của Secret API Key (Anthropic) — kiểm tra độc lập.
  ///
  /// Giá trị: connected | invalid | missingPermissions | missingWorkspace | missing.
  /// Với nhà cung cấp khác (ví dụ OpenAI) trường này là NULL.
  secretKeyStatus String?

  /// Trạng thái kiểm tra của Admin API Key (Anthropic) — kiểm tra độc lập.
  ///
  /// Giá trị: connected | invalid | missingPermissions | missingWorkspace | missing.
  /// Với nhà cung cấp khác (ví dụ OpenAI) trường này là NULL.
  adminKeyStatus String?

  /// Trạng thái kiểm tra kết nối gần nhất: success | invalidKey | missingScope | unreachable.
  lastCheckStatus String?

  /// Thời điểm kiểm tra kết nối gần nhất.
  lastCheckedAt DateTime?

  /// Nhà cung cấp có công bố API usage/billing hay không.
  usageAvailable Boolean  @default(true)

  /// Danh sách model đọc được từ nhà cung cấp (JSON).
  modelsList     String?

  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  usageRecords UsageRecord[]
  budgets      Budget[]
  alerts       Alert[]

  @@index([userId])
  @@index([projectId])
  @@map("api_providers")
}

/// Ngân sách chi phí theo nhà cung cấp / dự án.
model Budget {
  id             String   @id @default(uuid())
  userId         String
  apiProviderId  String?
  projectId      String?
  monthlyLimit   Decimal  @db.Decimal(18, 4)
  currentSpend   Decimal  @default(0) @db.Decimal(18, 4)
  warningPercent Int      @default(80)
  periodStart    DateTime @default(now())
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiProvider ApiProvider? @relation(fields: [apiProviderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([apiProviderId])
  @@index([projectId])
  @@map("budgets")
}

/// Cảnh báo khi vượt ngưỡng hoặc độ trễ tăng.
model Alert {
  id            String    @id @default(uuid())
  userId        String
  apiProviderId String?
  type          String
  threshold     Decimal?  @db.Decimal(18, 4)
  isEnabled     Boolean   @default(true)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiProvider ApiProvider? @relation(fields: [apiProviderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@map("alerts")
}

/// Bản ghi mỗi lần gọi API — nguồn dữ liệu cho Dashboard / Analytics.
model UsageRecord {
  id               String   @id @default(uuid())
  userId           String
  projectId        String?
  apiProviderId    String
  model            String
  endpoint         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs        Int?
  statusCode       Int      @default(200)
  isSuccess        Boolean  @default(true)
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  apiProvider ApiProvider  @relation(fields: [apiProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, occurredAt])
  @@index([apiProviderId])
  @@map("usage_records")
}

/// Sự kiện sử dụng ứng dụng (app open, feature usage) — nguồn dữ liệu cho
/// Admin Dashboard và thống kê "lượt sử dụng ứng dụng".
///
/// Khác với [UsageRecord] (ghi lại mỗi lần gọi API AI), model này ghi lại
/// hành vi người dùng trong ứng dụng Flutter — tương đương với dữ liệu mà
/// Firebase Analytics thu thập.
model AppUsageEvent {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String?

  /// Tên sự kiện: `app_open` | `app_close` | `feature_usage` | `screen_view`.
  eventName String

  /// Tên tính năng được sử dụng (ví dụ `connect_provider`, `export_report`).
  feature   String?

  /// Màn hình liên quan (dùng cho `screen_view`).
  screen    String?

  /// Thông tin bổ sung dạng JSON (không chứa PII).
  metadata  String?

  platform  String?
  appVersion String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([occurredAt])
  @@map("app_usage_events")
}

/// Thiết bị Flutter đang chạy có thể nhận yêu cầu crash test.
///
/// Mỗi lần app khởi động, app đăng ký (hoặc cập nhật) một bản ghi ở đây kèm
/// `deviceId` sinh ra cục bộ. Admin Web dùng danh sách này để biết thiết bị
/// nào đang "online" và gửi lệnh crash.
model CrashTestDevice {
  id          String   @id @default(uuid())

  /// Định danh thiết bị sinh bởi app (UUID lưu cục bộ).
  deviceId    String   @unique

  userId      String?
  deviceName  String?
  platform    String?
  appVersion  String?

  /// Token thiết bị dùng để app tự báo cáo trạng thái crash.
  reportToken String?

  isOnline    Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  crashTestRequests CrashTestRequest[]

  @@index([userId])
  @@index([lastSeenAt])
  @@map("crash_test_devices")
}

/// Yêu cầu crash test do Admin Web phát ra.
///
/// Vòng đời: `pending` → `triggered` → `reported` (hoặc `failed`).
/// App Flutter polling sẽ nhận yêu cầu ở trạng thái `pending`, kích hoạt
/// crash có chủ đích rồi báo cáo lại trạng thái `triggered`/`reported`.
model CrashTestRequest {
  id          String   @id @default(uuid())

  /// Yêu cầu dành riêng cho một thiết bị; null = gửi tới mọi thiết bị online.
  deviceId    String?

  /// Người admin đã phát ra yêu cầu.
  requestedBy String?

  /// Tên hiển thị của admin đã phát ra yêu cầu (snapshot tại thời điểm gửi).
  requestedByName String?

  /// `pending` | `triggered` | `reported` | `failed`.
  status      String   @default("pending")

  /// Lý do / ghi chú do admin nhập khi phát yêu cầu.
  reason      String?

  /// Payload phản hồi từ app (kết quả báo cáo Crashlytics).
  result      String?

  /// Số lần app đã nhận & xử lý yêu cầu.
  attemptCount Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  triggeredAt DateTime?
  reportedAt  DateTime?

  device CrashTestDevice? @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull, onUpdate: NoAction)

  @@index([status])
  @@index([createdAt])
  @@map("crash_test_requests")
}
