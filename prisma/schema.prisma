// Prisma schema — TokenScope
// Nguồn dữ liệu: SQL Server (database "TokenScope")
//
// Lưu ý: SQL Server không hỗ trợ nhiều đường cascade tới cùng một bảng.
// Vì vậy các quan hệ "cha" được đặt NoAction/SetNull và việc xóa được
// thực hiện tường minh trong tầng service.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Người dùng của TokenScope.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  birthDate    DateTime?
  passwordHash String
  avatarUrl    String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  projects     Project[]
  apiProviders ApiProvider[]
  budgets      Budget[]
  alerts       Alert[]
  usageRecords UsageRecord[]

  @@index([email])
  @@map("users")
}

/// Phiên đăng nhập (token làm mới).
model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("sessions")
}

/// Dự án — nhóm các API key theo mục đích sử dụng.
model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  apiProviders ApiProvider[]
  usageRecords UsageRecord[]

  @@index([userId])
  @@map("projects")
}

/// Nhà cung cấp API (OpenAI, Anthropic, Google...).
model ApiProvider {
  id           String   @id @default(uuid())
  userId       String
  projectId    String?
  name         String
  providerType String
  baseUrl      String?
  apiKeyLast4  String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  usageRecords UsageRecord[]
  budgets      Budget[]
  alerts       Alert[]

  @@index([userId])
  @@index([projectId])
  @@map("api_providers")
}

/// Ngân sách chi phí theo nhà cung cấp / dự án.
model Budget {
  id             String   @id @default(uuid())
  userId         String
  apiProviderId  String?
  monthlyLimit   Decimal  @db.Decimal(18, 4)
  currentSpend   Decimal  @default(0) @db.Decimal(18, 4)
  warningPercent Int      @default(80)
  periodStart    DateTime @default(now())
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiProvider ApiProvider? @relation(fields: [apiProviderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@map("budgets")
}

/// Cảnh báo khi vượt ngưỡng hoặc độ trễ tăng.
model Alert {
  id            String    @id @default(uuid())
  userId        String
  apiProviderId String?
  type          String
  threshold     Decimal?  @db.Decimal(18, 4)
  isEnabled     Boolean   @default(true)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiProvider ApiProvider? @relation(fields: [apiProviderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@map("alerts")
}

/// Bản ghi mỗi lần gọi API — nguồn dữ liệu cho Dashboard / Analytics.
model UsageRecord {
  id               String   @id @default(uuid())
  userId           String
  projectId        String?
  apiProviderId    String
  model            String
  endpoint         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs        Int?
  statusCode       Int      @default(200)
  isSuccess        Boolean  @default(true)
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  apiProvider ApiProvider  @relation(fields: [apiProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, occurredAt])
  @@index([apiProviderId])
  @@map("usage_records")
}
